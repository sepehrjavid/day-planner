# Local development only. On Cloud Run these come from the service's env block,
# with GOOGLE_OAUTH_CLIENT_SECRET mounted from Secret Manager.
# Copy to .env — which is gitignored — and fill in.

GCP_PROJECT_ID=your-gcp-project-id
FIRESTORE_DATABASE=(default)

# Full resource name of the symmetric KMS key (terraform output kms_key_name)
KMS_KEY_NAME=projects/your-gcp-project-id/locations/europe-north1/keyRings/day-planner/cryptoKeys/oauth-tokens

# OAuth client of type "Web application" (NOT Desktop — a desktop client will
# refuse the Cloud Run redirect URI).
GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=

# No trailing slash. Must exactly match the redirect URI registered on the
# OAuth client. Locally: http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080

STATE_TTL_SECONDS=600

# /me/chat's target. Full resource name (terraform output: run
# `terraform output` after applying, or read it off
# google_vertex_ai_reasoning_engine.day_planner_agent in the Cloud Console).
AGENT_ENGINE_NAME=projects/your-gcp-project-id/locations/europe-west1/reasoningEngines/000000000000000000
AGENT_ENGINE_LOCATION=europe-west1
