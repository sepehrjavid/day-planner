GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# day_planner_backend_internal's own URL (terraform output internal_service_uri).
# calendar_tool.py mints its own OIDC token audienced to this value on every
# call — no credentials are stored here at all.
INTERNAL_BACKEND_URL=https://day-planner-internal-xxxxxxxxxx-xx.a.run.app

# Optional. Turns on AdkApp's tracing (agent.py leaves enable_tracing unset,
# so this env var is what decides it — requires google-adk >= 1.17). Spans
# export to Cloud Trace in GOOGLE_CLOUD_PROJECT above via OTLP.
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
