# Local development only. On Cloud Run these come from the service's env block,
# with GOOGLE_OAUTH_CLIENT_SECRET mounted from Secret Manager.
# Copy to .env — which is gitignored — and fill in.

GCP_PROJECT_ID=your-gcp-project-id
FIRESTORE_DATABASE=(default)

# Full resource name of the symmetric KMS key (terraform output kms_key_name)
KMS_KEY_NAME=projects/your-gcp-project-id/locations/europe-north1/keyRings/day-planner/cryptoKeys/oauth-tokens

# OAuth client of type "Web application". Same client as the app service —
# this service refreshes and revokes tokens using it, but never runs the
# consent redirect itself.
GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=

# Origin of the sibling day_planner_backend_app service — /internal/connect-link
# builds a URL pointing at /auth/{provider}/start there, not here.
# Locally, if you're running both services: http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080

# This service's own origin — the audience incoming OIDC tokens are checked
# against. Required (unlike the app service, every route here needs it).
SELF_BASE_URL=http://localhost:8081

# Service accounts permitted to call this service. Comma-separated.
# Empty means every route fails closed with a 503.
INTERNAL_CALLER_SERVICE_ACCOUNTS=day-planner-agent@your-gcp-project-id.iam.gserviceaccount.com

STATE_TTL_SECONDS=600
